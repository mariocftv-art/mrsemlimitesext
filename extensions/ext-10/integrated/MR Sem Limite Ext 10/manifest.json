{
  "manifest_version": 3,
  "name": "MR Sem Limite Ext 10 Final (Novo Método v4)",
  "version": "1.0.0",
  "description": "EXT10 PREMIUM: Motor V17 Nexus Engine desofuscado + Gold Design Studio + Backend MR Oficial.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "webRequest", "alarms"],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://lovable.dev/*",
    "https://*.lovable.app/*",
    "https://lovable.app/*",
    "https://cvbgrjauqjawrsyknhyj.supabase.co/*",
    "https://dwpuqewnfibeldegvimp.supabase.co/*",
    "https://hckncgrfhedoswsdkyni.supabase.co/*",
    "https://storage.googleapis.com/*"
  ],
  "action": {
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
    "default_title": "MR Sem Limite Ext 10"
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": { 
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "sidepanel.bundle.js", "logo-mr8.png", "jszip.min.js"],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["castle-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
