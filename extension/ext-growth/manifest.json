{
  "manifest_version": 3,
  "name": "MR Social Growth - EXT Growth",
  "version": "7.19.0",
  "description": "CRM lateral multi-plataforma (WhatsApp, Facebook, Telegram, Instagram, YouTube) para captura autorizada de leads, listas e envio de mídia (imagens e vídeos até 60 MB, com fallback automático para documento).",
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Abrir MR Social Growth",
    "default_icon": "icons/icon48.png"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://*.whatsapp.com/*",
    "https://*.telegram.org/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://mrsemlimites.lovable.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*",
        "https://*.whatsapp.com/*",
        "https://*.telegram.org/*",
        "https://*.instagram.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "scripts/automation.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}