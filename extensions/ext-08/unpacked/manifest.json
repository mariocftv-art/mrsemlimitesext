{
  "manifest_version": 3,
  "name": "LOV QYRON - Premium AI Assistant",
  "version": "6.1.1",
  "description": "Extensão premium com IA Neural, Chat de Voz em tempo real, Vibe Coding e Remover Marca (v6.1.1 + Migração Supabase (fix CSP))",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://*.lovableproject.com/*",
    "https://*.lovable.app/*",
    "https://qyrondev.lovable.app/*"
  ],
  "action": {
    "default_title": "LOV QYRON"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "page-injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.bundle.js",
        "popup.bundle.js",
        "jszip.min.js",
        "popup.html",
        "icon.png"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ]
    }
  ]
}