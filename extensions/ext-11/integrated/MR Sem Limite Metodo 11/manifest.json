{
  "manifest_version": 3,
  "name": "🚀 EXT11 — MR Sem Limite Ext 11 (Novo Método v4)",
  "version": "1.2.0",
  "description": "A unificação suprema: Motor original do Método 4 (EXT4) com o design Black & Gold Cockpit da EXT7. Versão 1.2.0. Inclui todas as abas profissionais, banco de licenças oficial MR Sem Limites, camada de segurança mr-security-pro.js, anti-inspeção F12 e manifesto de integridade.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://mrsemlimites.lovable.app/*",
    "https://mrsemlimitesext.lovable.app/*",
    "https://text.pollinations.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://graph.facebook.com/*",
    "https://graph.instagram.com/*",
    "https://api.instagram.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "content/castle-capture.js",
        "content/pageHook.js",
        "content/hwFingerprint.js",
        "content/lv-core.js",
        "content/upload-manager.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content/sound-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["lib/anti-inspect.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "MR Sem Limite Ext 11",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/alert.mp3",
        "assets/sounds/coin.mp3",
        "banner.png",
        "icons/*",
        "jszip.min.js",
        "logo.png",
        "popup.html",
        "popup.js",
        "remote-ui.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src blob: https://mrsemlimites.lovable.app https://mrsemlimitesext.lovable.app;"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "MR Sem Limite Ext 11 — Painel completo v1.2.0 com motor M4."
    }
  },
  "mrsl_namespace": "MRSL"
}
