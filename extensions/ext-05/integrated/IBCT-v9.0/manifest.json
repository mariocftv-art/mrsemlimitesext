{
  "manifest_version": 3,
  "name": "MR SEM LIMITES v7.1.5",
  "short_name": "MRSL V7",
  "version": "7.1.5",
  "description": "MR SEM LIMITES - Motor de Alta Performance MR Sem Limites Extension Factory.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://mrsemlimitesext.lovable.app/*",
    "https://id-preview--44455b56-b609-45e7-8e53-9fd580b3ca9f.lovable.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MR SEM LIMITES",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": [
        "branding.config.js",
        "jszip.min.js",
        "content.js",
        "popup-extras.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageHook.js",
        "images/*",
        "jszip.min.js",
        "icons/*"
      ],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    }
  ]
}
