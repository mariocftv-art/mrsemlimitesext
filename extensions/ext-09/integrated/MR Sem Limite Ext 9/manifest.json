{
  "manifest_version": 3,
  "name": "MR Sem Limite 2026",
  "version": "17.0",
  "description": "Extensão premium MR Sem Limite 2026 com motor V17.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "webRequest"],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://*.lovable.app/*",
    "https://api.lovable.app/*",
    "https://lovable.app/*",
    "https://cvbgrjauqjawrsyknhyj.supabase.co/*",
    "https://dwpuqewnfibeldegvimp.supabase.co/*",
    "https://hckncgrfhedoswsdkyni.supabase.co/*",
    "https://storage.googleapis.com/*"
  ],
  "action": {
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
    "default_title": "MR Sem Limite 2026"
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["castle-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
