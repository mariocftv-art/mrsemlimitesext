{
  "manifest_version": 3,
  "name": "MR Sem Limites Ext 5",
  "version": "5.1.3",
  "description": "MR Sem Limites Ext 5 \u2014 tudo da Ext 3 + aba Instagram (publicar posts e reels direto pela extens\u00e3o).",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "webRequestBody"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://generativelanguage.googleapis.com/*",
    "https://graph.facebook.com/*",
    "https://graph.instagram.com/*",
    "https://lovable-api.com/*",
    "https://lovable.dev/*",
    "https://mrsemlimites.lovable.app/*",
    "https://mrsemlimitesext.lovable.app/*",
    "https://text.pollinations.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "content/sound-detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MR Sem Limites Ext 5",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/alert.mp3",
        "assets/sounds/coin.mp3",
        "banner.png",
        "icons/*",
        "jszip.min.js",
        "logo.png",
        "popup.html",
        "popup.js",
        "remote-ui.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' https://graph.instagram.com https://graph.facebook.com https://mrsemlimitesext.lovable.app https://mrsemlimites.lovable.app https://lovable.dev https://*.lovable.dev https://api.lovable.dev https://lovable-api.com https://text.pollinations.ai https://generativelanguage.googleapis.com; media-src 'self' data:; frame-src https://mrsemlimitesext.lovable.app https://mrsemlimites.lovable.app;"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "MR Sem Limites Reformulada 2.1 \u2014 Central premium de produtividade, anima\u00e7\u00f5es, componentes, prompts e ferramentas."
    }
  },
  "mrsl_namespace": "MRSL"
}