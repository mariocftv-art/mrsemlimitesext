{
  "manifest_version": 3,
  "name": "MR Sem Limites",
  "version": "1.2.2",
  "description": "MR Sem Limites Reformulada 2.2 — Central premium com Motor Método Quatro (Créditos Infinitos).",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "webRequestBody"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://mrsemlimites.lovable.app/*",
    "https://text.pollinations.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "pageHook.js",
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "castle-capture.js",
        "lv-core.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "content/sound-detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MR Sem Limites",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/alert.mp3",
        "assets/sounds/coin.mp3",
        "banner.png",
        "icons/*",
        "jszip.min.js",
        "logo.png",
        "popup.html",
        "popup.js",
        "remote-ui.js",
        "castle-capture.js",
        "hwFingerprint.js",
        "lv-core.js",
        "pageHook.js",
        "upload-manager.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; frame-src blob: https://mrsemlimites.lovable.app;"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "MR Sem Limites Reformulada 2.2"
    }
  },
  "mrsl_namespace": "MRSL"
}