{
  "manifest_version": 3,
  "name": "MR Ext Sem Limites 3.5",
  "version": "3.5.1",
  "description": "MR Ext Sem Limites v3.5 - Sem chaves, motor Castler original",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "webRequestBody"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://mrsemlimites.lovable.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "pageHook.js",
        "castle-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "content.js",
        "inject.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "MR Ext Sem Limites",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "remote-ui.js",
        "jszip.min.js",
        "popup.html",
        "popup.js",
        "icons/*",
        "logo.png",
        "pageHook.js",
        "castle-capture.js",
        "lv-core.js",
        "hwFingerprint.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; frame-src blob: https://mrsemlimites.lovable.app;"
  }
}