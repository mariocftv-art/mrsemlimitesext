{
  "manifest_version": 3,
  "name": "MR Sem Limites Ext 4",
  "version": "4.1.2",
  "description": "Motor Turbinado: Build v5.0.2 + Castler (Método Quatro) Integrado.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "webRequestBody"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://mrsemlimites.lovable.app/*",
    "https://text.pollinations.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://graph.facebook.com/*",
    "https://graph.instagram.com/*",
    "https://api.instagram.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/sound-detector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MR Sem Limites 4",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pageHook.js",
        "castle-capture.js",
        "lv-core.js",
        "hwFingerprint.js",
        "assets/sounds/alert.mp3",
        "assets/sounds/coin.mp3",
        "banner.png",
        "icons/*",
        "jszip.min.js",
        "logo.png",
        "popup.html",
        "popup.js",
        "remote-ui.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
